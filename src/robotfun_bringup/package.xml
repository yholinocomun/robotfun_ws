<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotfun_bringup</name>
  <version>0.1.0</version>
  <description>Composition root del brazo 5 GDL + gripper: launch integradores que
    componen descripción y cinemática, y documentación de arquitectura/roadmap
    (MoveIt2, Gazebo, visión).</description>
  <maintainer email="yholicomun@gmail.com">yholi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robotfun_description</exec_depend>
  <exec_depend>robotfun_kinematics</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
