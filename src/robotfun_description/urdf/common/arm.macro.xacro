<?xml version="1.0"?>
<!-- ============================================================================
     arm.macro.xacro  —  esqueleto compartido del brazo 4 GDL (RECTO)
     ===========================================================================
     Cadena base_link → link_1..link_4 → tool0 con las medidas reales y el brazo
     RECTO (sin offsets). Reproduce EXACTAMENTE la FK del núcleo (TF == FK a 1e-16).

         D1=0.1375  A2=0.1277  A3=0.125 (medido)  HAND=0.12 (medido)  [m]

     El mismo esqueleto sirve para los dos modelos:
        use_mesh=false → PRIMITIVAS dimensionadas a las medidas (verifica DH/IK).
        use_mesh=true  → PIEZAS REALES del CAD (visualización del hardware).
     Ejes: joint_1=(0 0 1) yaw; joint_2/3/4=(0 -1 0) pitch. tool0 es solo un frame
     (sin cubo). El gripper se añade aparte (gripper.macro.xacro).
     ========================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mesh" value="package://robotfun_description/meshes/arm"/>
  <xacro:property name="lo" value="-1.5708"/>   <!-- −90°, límite real del servo -->
  <xacro:property name="hi" value="1.5708"/>    <!-- +90° (HOME=0 ⇒ servo a 90°) -->

  <xacro:macro name="robotfun_arm" params="use_mesh:=false">

    <link name="world"/>
    <joint name="base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/><parent link="world"/><child link="base_link"/>
    </joint>

    <!-- ===== base_link ===== -->
    <link name="base_link">
      <inertial><mass value="1.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="grey"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0 0 0.0309" rpy="0 0 0"/>
          <geometry><cylinder radius="0.045" length="0.0617"/></geometry>
          <material name="grey"/>
        </xacro:unless>
      </visual>
    </link>

    <joint name="joint_1" type="revolute">
      <origin xyz="0 0 0.0617" rpy="0 0 0"/><parent link="base_link"/><child link="link_1"/>
      <axis xyz="0 0 1"/><limit lower="${lo}" upper="${hi}" effort="10.0" velocity="1.5"/>
    </joint>

    <!-- ===== link_1 (yaw → hombro) ===== -->
    <link name="link_1">
      <inertial><origin xyz="0 0 0.038"/><mass value="0.5"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <origin xyz="0 0 -0.0617" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/eslabon1_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="white_grey"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0 0 0.0379" rpy="0 0 0"/>
          <geometry><cylinder radius="0.022" length="0.0758"/></geometry>
          <material name="black"/>
        </xacro:unless>
      </visual>
    </link>

    <joint name="joint_2" type="revolute">
      <origin xyz="0 0 0.0758" rpy="0 0 0"/><parent link="link_1"/><child link="link_2"/>
      <axis xyz="0 -1 0"/><limit lower="${lo}" upper="${hi}" effort="10.0" velocity="1.5"/>
    </joint>

    <!-- ===== link_2 (brazo, A2) ===== -->
    <link name="link_2">
      <inertial><origin xyz="0 0 0.064"/><mass value="0.4"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <origin xyz="0 0 -0.1375" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/eslabon2_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="white_grey"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0 0 0.0639" rpy="0 0 0"/>
          <geometry><cylinder radius="0.018" length="0.1277"/></geometry>
          <material name="red"/>
        </xacro:unless>
      </visual>
    </link>

    <joint name="joint_3" type="revolute">
      <origin xyz="0 0 0.1277" rpy="0 0 0"/><parent link="link_2"/><child link="link_3"/>
      <axis xyz="0 -1 0"/><limit lower="${lo}" upper="${hi}" effort="10.0" velocity="1.5"/>
    </joint>

    <!-- ===== link_3 (antebrazo, A3=0.125) ===== -->
    <link name="link_3">
      <inertial><origin xyz="0 0 0.0625"/><mass value="0.3"/>
        <inertia ixx="8e-4" ixy="0" ixz="0" iyy="8e-4" iyz="0" izz="8e-4"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <!-- eslabon3 se exportó en otra escala: usa 0.0001 (a 0.001 flota a ~2.4 m). -->
          <origin xyz="0 0 -0.2652" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/eslabon3_link.stl" scale="0.0001 0.0001 0.0001"/></geometry>
          <material name="white_grey"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0 0 0.0625" rpy="0 0 0"/>
          <geometry><cylinder radius="0.015" length="0.125"/></geometry>
          <material name="blue"/>
        </xacro:unless>
      </visual>
    </link>

    <joint name="joint_4" type="revolute">
      <origin xyz="0 0 0.125" rpy="0 0 0"/><parent link="link_3"/><child link="link_4"/>
      <axis xyz="0 -1 0"/><limit lower="${lo}" upper="${hi}" effort="10.0" velocity="1.5"/>
    </joint>

    <!-- ===== link_4 (muñeca + base del gripper = UN solo eslabón) =====
         En el modelo de meshes, link_4 = eslabon4 (pieza de muñeca/soporte del
         gripper). El gripper se fusiona aquí mismo (gripper.macro.xacro). -->
    <link name="link_4">
      <inertial><origin xyz="0 0 0.06"/><mass value="0.2"/>
        <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <origin xyz="0 0 -0.3902" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/eslabon4_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="black"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0 0 0.06" rpy="0 0 0"/>
          <geometry><cylinder radius="0.013" length="0.12"/></geometry>
          <material name="black"/>
        </xacro:unless>
      </visual>
    </link>

    <!-- tool0 = TCP (punta del gripper, HAND=0.12). Solo FRAME, sin cubo. -->
    <joint name="tool_fixed" type="fixed">
      <origin xyz="0 0 0.12" rpy="0 0 0"/><parent link="link_4"/><child link="tool0"/>
    </joint>
    <link name="tool0"/>

  </xacro:macro>
</robot>
