<?xml version="1.0"?>
<!-- ============================================================================
     arm.macro.xacro  —  esqueleto compartido del brazo 4 GDL
     ===========================================================================
     Define la cadena cinemática (base_link → link_1..link_4 → tool0) con los
     orígenes REALES del robot (brazo_ws) y los ejes corregidos para que el URDF
     reproduzca EXACTAMENTE la FK del núcleo `robotfun_kinematics` (verificado a
     0.0). El mismo esqueleto sirve para los dos modelos:
        use_mesh=false → visual con PRIMITIVAS dimensionadas a las medidas reales.
        use_mesh=true  → visual con las PIEZAS REALES del CAD (meshes).
     Así ambos modelos comparten juntas (joint_1..joint_4) y se mueven idénticos.

     Ejes: joint_1 = (0 0 1) [yaw]; joint_2/3/4 = (0 -1 0) [pitch]. El signo −1
     en los pitch es lo que hace coincidir el giro con la convención DH del núcleo.
     ========================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mesh" value="package://robotfun_description/meshes/arm"/>
  <xacro:property name="lo" value="-1.5708"/>   <!-- ±90°, igual que los servos -->
  <xacro:property name="hi" value="1.5708"/>

  <xacro:macro name="robotfun_arm" params="use_mesh:=false">

    <link name="world"/>
    <joint name="base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/><parent link="world"/><child link="base_link"/>
    </joint>

    <!-- ===== base_link ===== -->
    <link name="base_link">
      <inertial><mass value="1.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="grey"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0 0 0.0309" rpy="0 0 0"/>
          <geometry><cylinder radius="0.045" length="0.0617"/></geometry>
          <material name="grey"/>
        </xacro:unless>
      </visual>
    </link>

    <joint name="joint_1" type="revolute">
      <origin xyz="0 0 0.0617" rpy="0 0 0"/><parent link="base_link"/><child link="link_1"/>
      <axis xyz="0 0 1"/>
      <limit lower="${lo}" upper="${hi}" effort="10.0" velocity="1.5"/>
    </joint>

    <!-- ===== link_1 (yaw → hombro) ===== -->
    <link name="link_1">
      <inertial><origin xyz="0 0 0.038"/><mass value="0.5"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <origin xyz="0 0 -0.0617" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/eslabon1_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="white_grey"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0 0 0.0379" rpy="0 0 0"/>
          <geometry><cylinder radius="0.022" length="0.0758"/></geometry>
          <material name="black"/>
        </xacro:unless>
      </visual>
    </link>

    <joint name="joint_2" type="revolute">
      <origin xyz="0 0 0.0758" rpy="0 0 0"/><parent link="link_1"/><child link="link_2"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${lo}" upper="${hi}" effort="10.0" velocity="1.5"/>
    </joint>

    <!-- ===== link_2 (brazo) ===== -->
    <link name="link_2">
      <inertial><origin xyz="0 0 0.064"/><mass value="0.4"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <origin xyz="0 0 -0.1375" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/eslabon2_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="white_grey"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0 0 0.0639" rpy="0 0 0"/>
          <geometry><cylinder radius="0.018" length="0.1277"/></geometry>
          <material name="red"/>
        </xacro:unless>
      </visual>
    </link>

    <joint name="joint_3" type="revolute">
      <origin xyz="0 0 0.1277" rpy="0 0 0"/><parent link="link_2"/><child link="link_3"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${lo}" upper="${hi}" effort="10.0" velocity="1.5"/>
    </joint>

    <!-- ===== link_3 (antebrazo, con el offset radial real 0.038) ===== -->
    <link name="link_3">
      <inertial><origin xyz="0.019 0 0.061"/><mass value="0.3"/>
        <inertia ixx="8e-4" ixy="0" ixz="0" iyy="8e-4" iyz="0" izz="8e-4"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <!-- eslabon3 se exportó en otro marco/escala: usa 0.0001 (a 0.001 flota
               a ~2.4 m). Su centrado XY puede requerir ajuste fino en RViz. -->
          <origin xyz="0 0 -0.2652" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/eslabon3_link.stl" scale="0.0001 0.0001 0.0001"/></geometry>
          <material name="white_grey"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0.019 0 0.0607" rpy="0 0.3036 0"/>
          <geometry><cylinder radius="0.015" length="0.1271"/></geometry>
          <material name="blue"/>
        </xacro:unless>
      </visual>
    </link>

    <joint name="joint_4" type="revolute">
      <origin xyz="0.038 0 0.1213" rpy="0 0 0"/><parent link="link_3"/><child link="link_4"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${lo}" upper="${hi}" effort="10.0" velocity="1.5"/>
    </joint>

    <!-- ===== link_4 (muñeca → mano) ===== -->
    <link name="link_4">
      <inertial><origin xyz="0 0 0.05"/><mass value="0.15"/>
        <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/></inertial>
      <visual>
        <xacro:if value="${use_mesh}">
          <origin xyz="-0.038 0 -0.3865" rpy="0 0 0"/>
          <geometry><mesh filename="${mesh}/eslabon4_link.stl" scale="0.001 0.001 0.001"/></geometry>
          <material name="black"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <origin xyz="0 0 0.05" rpy="0 0 0"/>
          <geometry><cylinder radius="0.013" length="0.10"/></geometry>
          <material name="black"/>
        </xacro:unless>
      </visual>
    </link>

    <!-- ===== tool0 (TCP, HAND=0.10 sobre la muñeca) ===== -->
    <joint name="tool_fixed" type="fixed">
      <origin xyz="0 0 0.10" rpy="0 0 0"/><parent link="link_4"/><child link="tool0"/>
    </joint>
    <link name="tool0">
      <inertial><mass value="0.03"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.03 0.04 0.012"/></geometry>
        <material name="grey"/>
      </visual>
    </link>

  </xacro:macro>
</robot>
