<?xml version="1.0"?>
<!-- ============================================================================
     gripper.macro.xacro
     Dos macros, sin el cubo anterior:
       * gripper_primitive : gripper de 1 GDL (canal 6) con dedos finos de caja;
         se mueve (joint "gripper") para el modelo de medidas reales.
       * gripper_mesh_fused: el gripper real (STL de twin_ws) FUSIONADO y FIJO al
         eslabón de la muñeca → "un solo eslabón" con link_4. Sin cubo, sin flotar.
     ========================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== PRIMITIVO (móvil) ===== -->
  <xacro:macro name="gripper_primitive" params="parent *origin">
    <joint name="gripper" type="revolute">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/><child link="gripper_finger_left"/>
      <axis xyz="0 1 0"/>
      <limit effort="5.0" lower="0.0" upper="0.6" velocity="2.0"/>
    </joint>
    <link name="gripper_finger_left">
      <inertial><mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
      <visual>
        <origin xyz="0.012 0 0.018" rpy="0 0 0"/>
        <geometry><box size="0.006 0.012 0.036"/></geometry>
        <material name="red"/>
      </visual>
    </link>
    <joint name="gripper_right" type="revolute">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/><child link="gripper_finger_right"/>
      <axis xyz="0 1 0"/>
      <limit effort="5.0" lower="-0.6" upper="0.0" velocity="2.0"/>
      <mimic joint="gripper" multiplier="-1.0"/>
    </joint>
    <link name="gripper_finger_right">
      <inertial><mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
      <visual>
        <origin xyz="-0.012 0 0.018" rpy="0 0 0"/>
        <geometry><box size="0.006 0.012 0.036"/></geometry>
        <material name="red"/>
      </visual>
    </link>
  </xacro:macro>

  <!-- ===== MESH FUSIONADO (fijo) ===== -->
  <!-- Une el gripper real al eslabón de la muñeca como UN solo cuerpo rígido.
       grip_z desplaza la malla (marco CAD global de twin); afínalo en RViz. -->
  <xacro:macro name="gripper_mesh_fused" params="parent grip_z:=-0.36">
    <joint name="gripper_fixed" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/><child link="gripper_link"/>
    </joint>
    <link name="gripper_link">
      <inertial><mass value="0.04"/>
        <inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="2e-5"/></inertial>
      <visual>
        <origin xyz="0.0 0.008 ${grip_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotfun_description/meshes/gripper/left_gripper.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"/>
      </visual>
      <visual>
        <origin xyz="0.0 -0.008 ${grip_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotfun_description/meshes/gripper/right_gripper.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"/>
      </visual>
    </link>
  </xacro:macro>

</robot>
