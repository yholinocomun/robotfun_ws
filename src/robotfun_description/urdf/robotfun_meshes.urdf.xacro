<?xml version="1.0"?>
<!-- ============================================================================
     robotfun_meshes.urdf.xacro  —  MODELO DE PIEZAS REALES (meshes del CAD)
     ===========================================================================
     Mismo esqueleto y MISMAS juntas (joint_1..joint_4) que el modelo de medidas
     reales, pero con las PIEZAS REALES (meshes de brazo_ws). El gripper real
     (twin_ws) se FUSIONA a link_4 (la muñeca/soporte) como un solo cuerpo: ya no
     hay cubo ni piezas flotando.

     Se mueve con el mismo /joint_states que el modelo primitivo ⇒ cuando mandas
     una pose a la IK, este modelo de hardware también se mueve.

     CENTRADO: las STL vienen en un marco CAD global; el <origin> de cada <visual>
     (en arm.macro.xacro) y el grip_z del gripper son el punto de partida. Si algo
     se ve desfasado, ajústalo en RViz (ver scripts/mesh_bbox.py). El modelo
     primitivo (model:=primitives) es la referencia cinemática exacta.
     ========================================================================== -->
<robot name="robotfun_meshes" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find robotfun_description)/urdf/common/materials.xacro"/>
  <xacro:include filename="$(find robotfun_description)/urdf/common/arm.macro.xacro"/>
  <xacro:include filename="$(find robotfun_description)/urdf/common/gripper.macro.xacro"/>

  <xacro:robotfun_arm use_mesh="true"/>

  <!-- gripper real fusionado a la muñeca (un solo eslabón). Afina grip_z en RViz. -->
  <xacro:gripper_mesh_fused parent="link_4" grip_z="-0.36"/>

</robot>
