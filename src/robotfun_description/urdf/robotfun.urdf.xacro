<?xml version="1.0"?>
<!-- ============================================================================
     robotfun.urdf.xacro  —  MODELO CANÓNICO (primitivas, DH-exacto)
     ===========================================================================
     Brazo de 5 GDL (RRRRR) + gripper, generado DIRECTAMENTE desde la tabla DH
     **validada** de `robotfun_kinematics.core.dh_model`. Los orígenes de los
     joints provienen de `scripts/generate_dh_origins.py`, que verifica TF == FK
     a 1e-12 (FK(HOME) = [0.010, 0, 0.393] m).

         L0=0.010 L1=0.063 L2=0.120 L3=0.090 L4=0.030 L5=0.090 (m)

     Este es el modelo de referencia para cinemática, MoveIt2 y Gazebo (incluye
     <collision> e <inertial>). Para comparar con las piezas reales del robot,
     usar el modelo de meshes:  display.launch.py model:=meshes
     ========================================================================== -->
<robot name="robotfun" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find robotfun_description)/urdf/common/materials.xacro"/>
  <xacro:include filename="$(find robotfun_description)/urdf/common/gripper.macro.xacro"/>

  <xacro:property name="L1" value="0.063"/>
  <xacro:property name="L2" value="0.120"/>
  <xacro:property name="L4_len" value="0.120"/>  <!-- L3+L4 -->
  <xacro:property name="L5" value="0.090"/>
  <xacro:property name="lower" value="-1.5708"/> <!-- ±90°, igual que el firmware -->
  <xacro:property name="upper" value="1.5708"/>

  <!-- ===================== mundo / base ===================== -->
  <link name="world"/>
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/><child link="base_link"/>
  </joint>

  <!-- ===================== link_1 (J1 yaw base) ===================== -->
  <link name="link_1">
    <inertial>
      <origin xyz="0 0 0.0315" rpy="0 0 0"/><mass value="0.5"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.0315" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="${L1}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0315" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="${L1}"/></geometry>
    </collision>
  </link>
  <joint name="joint_1" type="revolute">
    <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
    <parent link="base_link"/><child link="link_1"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="${lower}" upper="${upper}" velocity="3.0"/>
  </joint>

  <!-- ===================== link_2 (J2 hombro, a2=L2) ===================== -->
  <link name="link_2">
    <inertial>
      <origin xyz="0.06 0 0" rpy="0 0 0"/><mass value="0.5"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
    <visual>
      <origin xyz="0.060 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder radius="0.016" length="${L2}"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.060 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder radius="0.016" length="${L2}"/></geometry>
    </collision>
  </link>
  <joint name="joint_2" type="revolute">
    <origin xyz="0.010000 0.000000 0.063000" rpy="1.570796 -1.570796 0.000000"/>
    <parent link="link_1"/><child link="link_2"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="${lower}" upper="${upper}" velocity="3.0"/>
  </joint>

  <!-- ===================== link_3 (J3 codo, Z3 colineal → nodo) ===== -->
  <link name="link_3">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
    </collision>
  </link>
  <joint name="joint_3" type="revolute">
    <origin xyz="0.120000 0.000000 0.000000" rpy="0.000000 0.000000 1.570796"/>
    <parent link="link_2"/><child link="link_3"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="${lower}" upper="${upper}" velocity="3.0"/>
  </joint>

  <!-- ===================== link_4 (J4 ROLL antebrazo, d4=L3+L4) ===== -->
  <link name="link_4">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/><mass value="0.3"/>
      <inertia ixx="8e-4" ixy="0" ixz="0" iyy="8e-4" iyz="0" izz="8e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="${L4_len}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="${L4_len}"/></geometry>
    </collision>
  </link>
  <joint name="joint_4" type="revolute">
    <origin xyz="0.000000 0.000000 0.000000" rpy="1.570796 0.000000 0.000000"/>
    <parent link="link_3"/><child link="link_4"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="${lower}" upper="${upper}" velocity="3.0"/>
  </joint>

  <!-- ===================== link_5 (J5 muñeca pitch, a5=L5) ========== -->
  <link name="link_5">
    <inertial>
      <origin xyz="0.045 0 0" rpy="0 0 0"/><mass value="0.2"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/>
    </inertial>
    <visual>
      <origin xyz="0.045 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder radius="0.013" length="${L5}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.045 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder radius="0.013" length="${L5}"/></geometry>
    </collision>
  </link>
  <joint name="joint_5" type="revolute">
    <origin xyz="0.000000 0.000000 0.120000" rpy="1.570796 -1.570796 0.000000"/>
    <parent link="link_4"/><child link="link_5"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="${lower}" upper="${upper}" velocity="3.0"/>
  </joint>

  <!-- ===================== efector final (tool0) ===================== -->
  <link name="tool0">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.03 0.012"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="tool_fixed" type="fixed">
    <origin xyz="0.090000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
    <parent link="link_5"/><child link="tool0"/>
  </joint>

  <!-- ===================== gripper (canal 6, primitivo) ============== -->
  <xacro:gripper_primitive parent="tool0">
    <origin xyz="0 0 0.006" rpy="0 0 0"/>
  </xacro:gripper_primitive>

</robot>
