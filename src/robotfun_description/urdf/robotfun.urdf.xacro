<?xml version="1.0"?>
<!-- ============================================================================
     robotfun.urdf.xacro  —  MODELO DE MEDIDAS REALES (primitivas)
     ===========================================================================
     Brazo 4 GDL (yaw + 3 pitch) + gripper, dibujado con PRIMITIVAS dimensionadas
     a las medidas reales del robot. Comparte el esqueleto (juntas joint_1..joint_4)
     con el modelo de meshes, y reproduce EXACTAMENTE la FK del núcleo
     `robotfun_kinematics` (TF == FK). Es el modelo para VERIFICAR la cinemática
     inversa. Incluye inertiales (preparado para Gazebo/MoveIt2).

     Para ver las piezas reales del CAD:  display.launch.py model:=meshes
     ========================================================================== -->
<robot name="robotfun" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find robotfun_description)/urdf/common/materials.xacro"/>
  <xacro:include filename="$(find robotfun_description)/urdf/common/arm.macro.xacro"/>
  <xacro:include filename="$(find robotfun_description)/urdf/common/gripper.macro.xacro"/>

  <xacro:robotfun_arm use_mesh="false"/>

  <xacro:gripper_primitive parent="tool0">
    <origin xyz="0 0 0.006" rpy="0 0 0"/>
  </xacro:gripper_primitive>

</robot>
