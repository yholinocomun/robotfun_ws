<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotfun_description</name>
  <version>0.1.0</version>
  <description>Descripción URDF/xacro del brazo de 5 GDL + gripper: modelo canónico
    de primitivas generado desde la tabla DH validada (TF == FK) y modelo de meshes
    reales del CAD para comparación, ambos con la misma interfaz de juntas.</description>
  <maintainer email="yholicomun@gmail.com">yholi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
