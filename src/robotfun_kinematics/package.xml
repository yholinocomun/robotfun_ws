<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotfun_kinematics</name>
  <version>0.1.0</version>
  <description>Cinemática directa e inversa (DH estándar) del brazo de 5 GDL + gripper:
    núcleo puro sin ROS (FK, Jacobiano, IK por DLS con J4 fijo/activo, trayectorias
    trapezoidales) y nodos ROS 2 (IK, comprobación FK, control diferencial).</description>
  <maintainer email="yholicomun@gmail.com">yholi</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
